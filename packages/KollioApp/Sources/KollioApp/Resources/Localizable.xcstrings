    "clarification.empty": {
      "comment": "An empty field is not an answer and is not sent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write something, or say you do not know"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez quelque chose, ou dites que vous ne savez pas"
          }
        }
      }
    },
    "clarification.answerPlaceholder": {
      "comment": "The input attached to a question. There is no chat and no transcript.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre réponse"
          }
        }
      }
    },
    "clarification.answer": {
      "comment": "The action that records an answer to a question.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondre"
          }
        }
      }
    },
    "clarification.unknown": {
      "comment": "Says a question is not known. A real answer, not an empty one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I don't know"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne sais pas"
          }
        }
      }
    },
    "clarification.unknownHint": {
      "comment": "Why saying 'I don't know' is offered: it is a real answer, and the uncertainty is preserved rather than becoming an empty field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the uncertainty as it is. It stays unknown rather than becoming a blank answer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez l’incertitude telle quelle. Elle reste inconnue plutôt qu’une réponse vide"
          }
        }
      }
    },
    "clarification.unknownDone": {
      "comment": "Confirms that a question is not known.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stays unknown"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle reste inconnue"
          }
        }
      }
    },
    "status.answerSuperseded": {
      "comment": "An answer arrived after the person had moved on, and was dropped. Says so rather than showing nothing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That answer arrived after you had moved on, so it was not used"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réponse est arrivée après votre dernière action : elle n’a pas été utilisée"
          }
        }
      }
    },
    "action.retry": {
      "comment": "Asks the same question again as a new, linked request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask again"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redemander"
          }
        }
      }
    },
    "action.retryHint": {
      "comment": "A retry is a new request that points at the one before it, never an invisible repeat.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask again as a new request, linked to this one"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redemander comme une nouvelle demande, liée à celle-ci"
          }
        }
      }
    },
    "action.cancelHint": {
      "comment": "Cancelling keeps everything typed. It only stops the work in flight.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the work. Nothing you typed is lost"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête le travail. Rien de ce que vous avez écrit n’est perdu"
          }
        }
      }
    },
    "relationship.incomplete": {
      "localization": {
        "en": {
          "stringUnit": {
