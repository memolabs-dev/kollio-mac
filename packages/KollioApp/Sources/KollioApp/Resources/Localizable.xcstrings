      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked %lld for review"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld marqué(s) pour révision"
          }
        }
      }
    },
