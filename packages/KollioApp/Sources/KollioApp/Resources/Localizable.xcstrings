          "stringUnit": {
            "state": "translated",
            "value": "Renommer"
          }
        }
      }
    },
    "frame.renameHint": {
      "comment": "Says what renaming does not do, which is the surprising half.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renames the frame only. Nothing inside it changes."
