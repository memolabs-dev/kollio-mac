    "relationship.changeKindHint": {
      "localization": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change what this link claims, in words rather than by moving the arrow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer ce que ce lien affirme, en mots et non en déplaçant la flèche."
