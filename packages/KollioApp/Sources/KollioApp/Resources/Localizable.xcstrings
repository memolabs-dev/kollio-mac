    "spatial.draft.rebase": {
      "comment": "Spatial Ink C2.11 recoverable editing and explicit conflict resolution",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use current version to retry my draft"
          }
