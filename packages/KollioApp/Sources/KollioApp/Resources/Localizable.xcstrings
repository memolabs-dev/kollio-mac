    "frame.rename": {
      "comment": "Renames the frame, and nothing inside it: a branch's name is not its sources' name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename"
          }
        },
