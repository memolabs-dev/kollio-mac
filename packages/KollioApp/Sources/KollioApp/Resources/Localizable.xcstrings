        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre mon brouillon sur la version actuelle"
          }
        }
      }
    },
    "spatial.draft.rebased": {
      "comment": "Spatial Ink C2.11 recoverable editing and explicit conflict resolution",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest version acknowledged. Review your draft before confirming."
