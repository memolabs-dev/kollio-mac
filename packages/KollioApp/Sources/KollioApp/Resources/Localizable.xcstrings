    },
    "frame.fold": {
      "comment": "Hides the frame's contents in this view. Not a decision: the text, the links and the claims are untouched.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fold"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Replier"
          }
        }
      }
    },
    "frame.foldHint": {
      "comment": "Explains that folding is a view state, not 'set aside'.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides these here. Nothing is set aside, nothing is deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque ici. Rien n’est écarté, rien n’est supprimé."
          }
        }
      }
    },
    "frame.unfold": {
      "comment": "Shows the frame's contents again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfold"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplier"
          }
        }
      }
    },
    "frame.remove": {
      "comment": "Removes the frame and leaves everything inside it exactly where it is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the frame"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer le cadre"
          }
        }
      }
    },
    "frame.removeHint": {
      "comment": "The members stay: removing a frame is removing the frame.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The contents stay where they are."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu reste en place."
          }
