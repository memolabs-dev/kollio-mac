{
  "sourceLanguage": "fr",
  "strings": {
    "spatial.navigation.actions": {
      "comment": "CAN-02 C2.18 contextual access to selected-card actions in compact windows",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card actions"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions de la carte"
          }
        }
      }
    },
    "spatial.navigation.actionsHint": {
      "comment": "CAN-02 C2.18 contextual access to selected-card actions in compact windows",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to the selected card’s editing, movement and relationship commands without dragging."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atteindre les commandes d’édition, de déplacement et de liaison de la carte sans glisser."
          }
        }
      }
    },
    "spatial.pending.notice": {
      "comment": "C2.12 honest canonical save versus uncommitted text and explicit discard",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unconfirmed inputs: %d. Save writes the document, not these texts. Closing this window loses them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisies non validées : %d. Enregistrer conserve le document, pas ces textes. Fermer cette fenêtre les perd."
          }
        }
      }
    },
    "spatial.pending.savedButPending": {
      "comment": "C2.12 honest canonical save versus uncommitted text and explicit discard",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Document saved. Unconfirmed inputs NOT saved: %d. Confirm before closing this window."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Document enregistré. Saisies non sauvegardées : %d. Valide-les avant de fermer cette fenêtre."
          }
        }
      }
    },
    "spatial.draft.discard": {
      "comment": "C2.12 honest canonical save versus uncommitted text and explicit discard",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard this draft"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner ce brouillon"
          }
        }
      }
    },
    "spatial.draft.discardPrompt": {
      "comment": "C2.12 honest canonical save versus uncommitted text and explicit discard",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard your unfinished text?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner ton texte en cours ?"
          }
        }
      }
    },
    "spatial.draft.discardDetails": {
      "comment": "C2.12 honest canonical save versus uncommitted text and explicit discard",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this pending draft is removed. The saved document stays unchanged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul ce brouillon non validé est supprimé. Le document enregistré reste inchangé."
          }
        }
      }
    },
    "spatial.draft.discarded": {
      "comment": "C2.12 honest canonical save versus uncommitted text and explicit discard",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft discarded. The document was not changed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brouillon abandonné. Le document n’a pas été modifié."
          }
        }
      }
    },
    "spatial.draft.languageChanged": {
      "comment": "C2.11 prevents writing a draft to a different language variant",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue du document a changé. Ferme l’édition pour conserver ce brouillon dans sa langue d’origine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document language changed. Close the editor to keep this draft in its original language."
          }
        }
      }
    },
    "spatial.draft.saved": {
      "comment": "Spatial Ink C2.11 recoverable editing and explicit conflict resolution",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft kept. Resume editing to continue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brouillon conservé. Reprends l’édition pour continuer."
          }
        }
      }
    },
    "spatial.draft.recovered": {
      "comment": "Spatial Ink C2.11 recoverable editing and explicit conflict resolution",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovered the draft you were editing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brouillon d’édition récupéré."
          }
        }
      }
    },
    "spatial.draft.resume": {
      "comment": "Spatial Ink C2.11 recoverable editing and explicit conflict resolution",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume draft"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre le brouillon"
          }
        }
      }
    },
    "spatial.draft.pause": {
      "comment": "Spatial Ink C2.11 recoverable editing and explicit conflict resolution",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep draft and close"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver le brouillon et fermer"
          }
        }
      }
    },
    "spatial.draft.conflict": {
      "comment": "Spatial Ink C2.11 recoverable editing and explicit conflict resolution",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document changed while you were editing. Your draft is safe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document a changé pendant l’édition. Ton brouillon est conservé."
          }
        }
      }
    },
    "spatial.draft.current": {
      "comment": "Spatial Ink C2.11 recoverable editing and explicit conflict resolution",
